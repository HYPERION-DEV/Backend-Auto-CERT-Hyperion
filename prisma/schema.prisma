datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  OPERATOR
  ADMIN
}

enum EntityType {
  PERSONA_NATURAL
  EMPRESA
}

enum DocType {
  DNI
  CE
  RUC
  PASAPORTE
}

enum RequestStatus {
  BORRADOR
  EN_REVISION
  RECHAZADO
  APROBADO
  CANCELADO
}

enum DocumentCategory {
  DNI_FRONT_BACK
  FICHA_RUC
  VIGENCIA_PODER
  OTRO
}

enum IdentityStatus {
  PENDING
  REGISTERED
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  docType      DocType  @default(DNI)
  docNumber    String   @unique
  phone        String?
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests             CertificateRequest[]
  auditLogs            AuditLog[]
  verificationRequests VerificationRequest[]

  @@map("users")
}

model CertificateRequest {
  id             String        @id @default(uuid())
  code           String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  entityType     EntityType    @default(PERSONA_NATURAL)
  planType       String        @default("ONE_SHOT")
  status         RequestStatus @default(EN_REVISION)
  progress       String        @default("0/1")

  identityStatus   IdentityStatus @default(PENDING)
  identityVerified Boolean        @default(false)
  biocamerClientId String?
  biocamerUrl      String?

  applicantDocType  DocType @default(DNI)
  applicantDocNum   String
  applicantNames    String
  applicantSurname1 String
  applicantSurname2 String
  applicantEmail    String
  applicantPhone    String

  department String?
  province   String?
  district   String?
  address    String?
  postalCode String?

  companyRuc  String?
  companyName String?
  rucType     String?

  documents RequestDocument[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("certificate_requests")
}

model RequestDocument {
  id        String             @id @default(uuid())
  requestId String
  request   CertificateRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  category      DocumentCategory
  fileName      String
  fileUrl       String
  storagePath   String?            // Path interno en Supabase Storage
  mimeType      String             @default("application/pdf")
  fileSizeBytes Int?

  uploadedAt DateTime @default(now())

  verificationResult VerificationResult?

  @@map("request_documents")
}

model VerificationResult {
  id          String          @id @default(uuid())
  documentId  String          @unique
  document    RequestDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  isMatch             Boolean
  inputDocumentNum    String
  detectedDocumentNum String?

  extractedNames       String?
  extractedSurname1    String?
  extractedSurname2    String?
  extractedBirthDate   String?
  extractedExpiryDate  String?
  extractedNationality String?

  extractedDepartment String?
  extractedProvince   String?
  extractedDistrict   String?
  extractedAddress    String?

  extractedRuc         String?
  extractedCompanyName String?
  extractedRucStatus   String?
  extractedRucCond     String?
  extractedIssueDate   String?

  rejectionReason  String?
  rawAiJsonResponse Json?

  verifiedAt DateTime @default(now())

  @@map("verification_results")
}

model VerificationRequest {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  entityType EntityType @default(PERSONA_NATURAL)

  docType        DocType @default(DNI)
  documentNumber String

  extractedFirstName String?
  extractedLastName  String?
  extractedFullName   String?

  department String?
  province   String?
  district   String?
  address    String?

  email String?
  phone String?

  companyRuc  String?
  companyName String?

  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification_requests")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model PostalCode {
  code        String   @db.VarChar(5) // Ej: "11003"
  districts   String   // Ej: "La Tinguiña, Parcona"
  province    String   // Ej: "Ica"
  department  String   // Ej: "Ica"

  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  @@index([department, province])
  @@map("postal_codes")
}